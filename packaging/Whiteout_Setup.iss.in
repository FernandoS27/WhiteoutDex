; ============================================================================
; WhiteoutDex Toolkit - Inno Setup Installer Script
; Warcraft III MDX/MDL Modeling Toolkit for 3ds Max 2016-2027
;
; Configured by CMake from packaging/Whiteout_Setup.iss.in — do not edit the
; generated copy under <build>/packaging/. See the root CMakeLists.txt for the
; substitution list (version, paths, per-version [Files] block).
; ============================================================================

#define MyAppName      "WhiteoutDex Toolkit"
#define MyAppVersion   "@WDX_VERSION@"
#define MyAppPublisher "Whiteout Contributors"
#define MyAppURL       "https://www.whiteout.de"

; --- GitHub Update Config ---
#define GitHubUser     "FernandoS27"
#define GitHubRepo     "WhiteoutDex"

[Setup]
AppId={{C508AF39-A032-496D-AC08-EE5B20E69FDB}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL=https://github.com/{#GitHubUser}/{#GitHubRepo}/releases
VersionInfoVersion={#MyAppVersion}

; Install location is decided by Pascal (GetDefaultDir) so the package lands
; where the user's Max version can actually find it:
;   Max ≤2018 → %ALLUSERSPROFILE%\Autodesk\ApplicationPlugins\WhiteoutDex
;                (Max 2016/2017/2018 only scan this path)
;   Max ≥2019 → %APPDATA%\Autodesk\ApplicationPlugins\WhiteoutDex
;                (per-user; no scattered system files)
;   Neither   → defaults to %APPDATA% (still valid for Max 2019+ if they later
;                install one).
DefaultDirName={code:GetDefaultDir}
DirExistsWarning=no
DisableProgramGroupPage=yes
DisableDirPage=yes

; Output
OutputDir=@WDX_INSTALLER_OUTPUT_DIR@
OutputBaseFilename=WhiteoutDex_Setup_v{#MyAppVersion}

; Compression
Compression=lzma2/ultra64
SolidCompression=yes
LZMANumBlockThreads=4

; Misc
; Admin required because Max ≤2018 needs the package under ProgramData. The
; UAC prompt is cheap; if the user only has modern Max we still install to
; AppData (no scattering of system files), but elevation lets one installer
; cover both cases without re-running.
PrivilegesRequired=admin
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
LicenseFile=@WDX_REPO_ROOT@\LICENSE.md
WizardStyle=modern
WizardSizePercent=120
ShowLanguageDialog=no
LanguageDetectionMethod=uilanguage

; Allow update over existing installation
UsePreviousAppDir=yes
CloseApplications=no

[Languages]
; Languages bundled with a stock Inno Setup 6 install. ChineseSimplified is
; not shipped by default; add it via the official Inno Setup language pack
; (https://jrsoftware.org/files/istrans/) if you need it.
Name: "english";   MessagesFile: "compiler:Default.isl"
Name: "german";    MessagesFile: "compiler:Languages\German.isl"
Name: "japanese";  MessagesFile: "compiler:Languages\Japanese.isl"
Name: "russian";   MessagesFile: "compiler:Languages\Russian.isl"
Name: "korean";    MessagesFile: "compiler:Languages\Korean.isl"

; ============================================================================
; FILES
; ============================================================================
[Files]

; === ROOT FILES ===
; PackageContents.xml comes from the CMake-generated copy under <build>/packaging/
; so SeriesMin/SeriesMax and the per-version <Components> blocks track WDX_MAX_VERSIONS.
Source: "@WDX_PACKAGE_CONTENTS_XML@";           DestDir: "{app}"; DestName: "PackageContents.xml"; Flags: ignoreversion
Source: "@WDX_REPO_ROOT@\LICENSE.md";           DestDir: "{app}"; Flags: ignoreversion
Source: "@WDX_REPO_ROOT@\THIRD_PARTY.md";       DestDir: "{app}"; Flags: ignoreversion
Source: "@WDX_REPO_ROOT@\version.txt";          DestDir: "{app}"; Flags: ignoreversion

; Settings file: only install if not already present (preserves user customisations)
Source: "@WDX_REPO_ROOT@\WhiteoutDex_Settings.ini"; DestDir: "{app}"; Flags: onlyifdoesntexist

; === WhiteoutDex icons (UI assets) ===
Source: "@WDX_REPO_ROOT@\whiteoutdex_icons\*"; DestDir: "{app}\whiteoutdex_icons"; \
    Flags: ignoreversion recursesubdirs skipifsourcedoesntexist

; === NATIVE PLUGINS — one block per Max version, generated by CMake from WDX_MAX_VERSIONS.
;     Each entry uses skipifsourcedoesntexist so partial stage trees still pack cleanly. ===
@WDX_NATIVE_PLUGINS_BLOCK@

; === MaxScript assets — staged under <build>/stage/scripts/ ===
Source: "@WDX_STAGE_DIR@\scripts\macroscripts\*.mcr";          \
    DestDir: "{app}\scripts\macroscripts";          Flags: ignoreversion
Source: "@WDX_STAGE_DIR@\scripts\pre_startup_scripts\*.ms";    \
    DestDir: "{app}\scripts\pre_startup_scripts";   Flags: ignoreversion
Source: "@WDX_STAGE_DIR@\scripts\post_startup_scripts\*.ms";   \
    DestDir: "{app}\scripts\post_startup_scripts";  Flags: ignoreversion
Source: "@WDX_STAGE_DIR@\scripts\scripted_plugins\*.ms";       \
    DestDir: "{app}\scripts\scripted_plugins";      Flags: ignoreversion

; === MAPS (TeamGlow textures etc.) ===
Source: "@WDX_REPO_ROOT@\resources\maps\*"; DestDir: "{app}\maps"; \
    Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist

; ============================================================================
; REGISTRY — track version + install path so the Pascal upgrade check
; can find a previous Inno Setup install. HKLM because the installer runs
; elevated and we want the marker visible to every user of the machine.
; ============================================================================
[Registry]
Root: HKLM; Subkey: "Software\WhiteoutDex"; ValueType: string; \
    ValueName: "InstallPath"; ValueData: "{app}";          Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\WhiteoutDex"; ValueType: string; \
    ValueName: "Version";     ValueData: "{#MyAppVersion}"; Flags: uninsdeletekey

; ============================================================================
; FOLDERS REMOVED ON UNINSTALL
; (maps/ is preserved — user data)
; ============================================================================
[UninstallDelete]
Type: filesandordirs; Name: "{app}\whiteoutdex_icons"
Type: filesandordirs; Name: "{app}\native plugins"
Type: filesandordirs; Name: "{app}\scripts"
Type: files;          Name: "{app}\PackageContents.xml"
Type: files;          Name: "{app}\LICENSE.md"
Type: files;          Name: "{app}\THIRD_PARTY.md"
Type: files;          Name: "{app}\WhiteoutDex_Settings.ini"
Type: files;          Name: "{app}\version.txt"

; ============================================================================
; PASCAL SCRIPT
; ============================================================================
[Code]

// -------------------------------------------------------
// 3ds Max install-path detection.
//
// Product version = (year - 1998). Max 2016 = 18.0, Max 2017 = 19.0, …
// Max writes HKLM\SOFTWARE\Autodesk\3dsMax\<major>.0\Installdir on install,
// but Express/EDU/etc. installs sometimes skip it — also probe the default
// install dir as a fallback.
// -------------------------------------------------------
function IsMaxYearInstalled(Year: Integer): Boolean;
var
  MajorStr: String;
  Dummy: String;
  ExePath: String;
begin
  MajorStr := IntToStr(Year - 1998) + '.0';
  Result := RegQueryStringValue(HKLM,
              'SOFTWARE\Autodesk\3dsMax\' + MajorStr, 'Installdir', Dummy);
  if Result then Exit;
  ExePath := ExpandConstant('{pf}\Autodesk\3ds Max ' + IntToStr(Year) + '\3dsmax.exe');
  Result := FileExists(ExePath);
end;

// True when the user has any Max 2016-2018 installed. Those versions only
// scan %ALLUSERSPROFILE%\Autodesk\ApplicationPlugins (ProgramData); newer
// Max versions also scan %APPDATA%, so we only need to leave AppData for
// those.
function NeedsProgramDataInstall(): Boolean;
var
  Year: Integer;
begin
  Result := False;
  for Year := 2016 to 2018 do
    if IsMaxYearInstalled(Year) then begin
      Result := True;
      Exit;
    end;
end;

// -------------------------------------------------------
// Default-install-dir selector, wired to DefaultDirName via {code:GetDefaultDir}.
// -------------------------------------------------------
function GetDefaultDir(Param: String): String;
begin
  if NeedsProgramDataInstall() then
    Result := ExpandConstant('{commonappdata}\Autodesk\ApplicationPlugins\WhiteoutDex')
  else
    Result := ExpandConstant('{userappdata}\Autodesk\ApplicationPlugins\WhiteoutDex');
end;

// -------------------------------------------------------
// Detect .NET 8.0 Desktop Runtime (required for Max 2026+ managed wrappers).
// -------------------------------------------------------
function IsDotNet8Installed(): Boolean;
var
  FindRec: TFindRec;
begin
  Result := FindFirst(ExpandConstant('{pf}\dotnet\shared\Microsoft.WindowsDesktop.App\8.*'), FindRec);
  if Result then
    FindClose(FindRec);
end;

// -------------------------------------------------------
// Detect Autodesk AppData presence (sanity check — 3ds Max installed?)
// -------------------------------------------------------
function IsAutodeskInstalled(): Boolean;
begin
  Result := DirExists(ExpandConstant('{userappdata}\Autodesk'));
end;

// -------------------------------------------------------
// Read previous version from version.txt in the install dir.
// -------------------------------------------------------
function GetOldVersion(InstallDir: String): String;
var
  VersionFile: String;
  Lines: TArrayOfString;
begin
  Result := '';
  VersionFile := InstallDir + '\version.txt';
  if FileExists(VersionFile) then
  begin
    if LoadStringsFromFile(VersionFile, Lines) and (GetArrayLength(Lines) > 0) then
      Result := Trim(Lines[0]);
  end;
end;

// -------------------------------------------------------
// Read previous Inno Setup uninstall string (if a prior install exists).
// -------------------------------------------------------
function GetPreviousInnoUninstallString(): String;
var
  UninstallKey: String;
begin
  Result := '';
  UninstallKey := 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{#SetupSetting("AppId")}_is1';
  // Admin installs land in HKLM; older HKCU-installed copies are still
  // checked as a fallback for users upgrading from the lowest-privileges
  // version of the installer.
  if not RegQueryStringValue(HKLM, UninstallKey, 'UninstallString', Result) then
    if not RegQueryStringValue(HKCU, UninstallKey, 'UninstallString', Result) then
      Result := '';
end;

// -------------------------------------------------------
// Silently uninstall the previous Inno Setup version.
// -------------------------------------------------------
function UninstallPreviousInnoSetup(): Boolean;
var
  UninstallString: String;
  ResultCode: Integer;
begin
  Result := True;
  UninstallString := GetPreviousInnoUninstallString();

  if UninstallString <> '' then
  begin
    Log('Previous Inno Setup installation found. Uninstalling...');

    // Strip surrounding quotes
    if (Length(UninstallString) > 1) and (UninstallString[1] = '"') then
      UninstallString := Copy(UninstallString, 2, Length(UninstallString) - 2);

    if Exec(UninstallString, '/VERYSILENT /SUPPRESSMSGBOXES /NORESTART', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
    begin
      Log('Previous version successfully uninstalled.');
      // Brief pause so the OS releases file handles
      Sleep(1000);
    end else
    begin
      Log('Uninstall failed (code: ' + IntToStr(ResultCode) + ')');
    end;
  end;
end;

// -------------------------------------------------------
// Clean up an older batch-file installation (`install.bat`).
// Removes everything we are about to reinstall but preserves
// user-owned maps/ and WhiteoutDex_Settings.ini.
// -------------------------------------------------------
procedure CleanOldBatInstallation();
var
  AppDir: String;
begin
  AppDir := ExpandConstant('{app}');

  if DirExists(AppDir) then
  begin
    Log('Old installation found — cleaning up...');

    DelTree(AppDir + '\scripts', True, True, True);
    DelTree(AppDir + '\native plugins', True, True, True);
    DelTree(AppDir + '\whiteoutdex_icons', True, True, True);

    DeleteFile(AppDir + '\PackageContents.xml');
    DeleteFile(AppDir + '\LICENSE.md');
    DeleteFile(AppDir + '\THIRD_PARTY.md');

    DeleteFile(AppDir + '\install.bat');
    DeleteFile(AppDir + '\uninstall.bat');

    Log('Cleanup complete. maps/ and Settings preserved.');
  end;
end;

// -------------------------------------------------------
// Setup initialisation — detect existing installs and prompt the user.
// -------------------------------------------------------
function InitializeSetup(): Boolean;
var
  AppDir: String;
  OldVersion: String;
  HasOldInno: Boolean;
  HasOldBat: Boolean;
  Msg: String;
begin
  Result := True;
  AppDir := GetDefaultDir('');

  if not IsAutodeskInstalled() then
  begin
    if MsgBox(
      'The Autodesk AppData folder was not found.' + #13#10 +
      'Is 3ds Max installed?' + #13#10#13#10 +
      'Install anyway?',
      mbConfirmation, MB_YESNO) = IDNO then
    begin
      Result := False;
      Exit;
    end;
  end;

  HasOldInno := (GetPreviousInnoUninstallString() <> '');
  HasOldBat  := (not HasOldInno) and DirExists(AppDir) and FileExists(AppDir + '\PackageContents.xml');

  if HasOldInno then
  begin
    OldVersion := GetOldVersion(AppDir);
    if OldVersion <> '' then
      Msg := 'WhiteoutDex Toolkit v' + OldVersion + ' is already installed.'
    else
      Msg := 'A previous version of WhiteoutDex Toolkit is installed.';

    Msg := Msg + #13#10#13#10 +
      'The old version will be uninstalled automatically before updating.' + #13#10 +
      'Your maps folder and settings will be preserved.' + #13#10#13#10 +
      'Continue?';

    if MsgBox(Msg, mbConfirmation, MB_YESNO) = IDNO then
    begin
      Result := False;
      Exit;
    end;

    UninstallPreviousInnoSetup();

  end else if HasOldBat then
  begin
    OldVersion := GetOldVersion(AppDir);
    if OldVersion <> '' then
      Msg := 'WhiteoutDex Toolkit v' + OldVersion + ' was found (installed via batch file).'
    else
      Msg := 'A previous WhiteoutDex installation was found (installed via batch file).';

    Msg := Msg + #13#10#13#10 +
      'The old installation will be cleaned up and replaced.' + #13#10 +
      'Your maps folder and settings will be preserved.' + #13#10#13#10 +
      'Continue?';

    if MsgBox(Msg, mbConfirmation, MB_YESNO) = IDNO then
    begin
      Result := False;
      Exit;
    end;
  end;

  // Non-blocking .NET 8 advisory.
  if not IsDotNet8Installed() then
  begin
    MsgBox(
      'Note: .NET 8.0 Desktop Runtime was not detected.' + #13#10#13#10 +
      'WhiteoutDex Native features for Max 2026+ require it.' + #13#10 +
      'Download: https://dotnet.microsoft.com/download/dotnet/8.0' + #13#10#13#10 +
      'The installation will continue. You can install .NET 8.0 later.',
      mbInformation, MB_OK);
  end;
end;

// -------------------------------------------------------
// Patch PackageContents.xml post-install:
//   - AppVersion → current installer version
//   - ProductCode → fresh GUID (UpgradeCode is never touched)
// -------------------------------------------------------
procedure UpdatePackageContentsXml();
var
  XmlFile: String;
  Content: AnsiString;
  NewProductCode: String;
  PosStart, PosEnd: Integer;
  Before, After: String;
begin
  XmlFile := ExpandConstant('{app}\PackageContents.xml');
  if not FileExists(XmlFile) then Exit;

  if not LoadStringFromFile(XmlFile, Content) then Exit;

  // --- AppVersion ---
  PosStart := Pos('AppVersion="', Content);
  if PosStart > 0 then
  begin
    PosStart := PosStart + Length('AppVersion="');
    PosEnd := PosStart;
    while (PosEnd <= Length(Content)) and (Content[PosEnd] <> '"') do
      PosEnd := PosEnd + 1;

    Before := Copy(Content, 1, PosStart - 1);
    After := Copy(Content, PosEnd, Length(Content) - PosEnd + 1);
    Content := Before + '{#MyAppVersion}' + After;

    Log('PackageContents.xml: AppVersion set to {#MyAppVersion}.');
  end;

  // --- ProductCode (date+time-derived; deterministic per install) ---
  NewProductCode := '{' + GetDateTimeString('yyyy', #0, #0)
    + GetDateTimeString('mmdd', #0, #0)
    + '-' + GetDateTimeString('hhmm', #0, #0)
    + '-' + '{#MyAppVersion}'
    + '-0000-NEODEXTOOL}';

  PosStart := Pos('ProductCode="', Content);
  if PosStart > 0 then
  begin
    PosStart := PosStart + Length('ProductCode="');
    PosEnd := PosStart;
    while (PosEnd <= Length(Content)) and (Content[PosEnd] <> '"') do
      PosEnd := PosEnd + 1;

    Before := Copy(Content, 1, PosStart - 1);
    After := Copy(Content, PosEnd, Length(Content) - PosEnd + 1);
    Content := Before + NewProductCode + After;

    Log('PackageContents.xml: ProductCode set to ' + NewProductCode + '.');
  end;

  // UpgradeCode is left untouched — it must stay stable.
  SaveStringToFile(XmlFile, Content, False);
  Log('PackageContents.xml updated.');
end;

// -------------------------------------------------------
// Install lifecycle hooks.
// -------------------------------------------------------
procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssInstall then
  begin
    CleanOldBatInstallation();
  end;

  if CurStep = ssPostInstall then
  begin
    SaveStringToFile(
      ExpandConstant('{app}\version.txt'),
      '{#MyAppVersion}',
      False
    );

    UpdatePackageContentsXml();
  end;
end;
