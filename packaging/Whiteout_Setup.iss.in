; ============================================================================
; WhiteoutDex Toolkit - Inno Setup Installer Script
; Warcraft III MDX/MDL Modeling Toolkit for 3ds Max 2016-2027
;
; One installer for every Max year the build produced (@WDX_MAX_YEARS_PASCAL@).
; It installs the version-independent files once, and only the per-year
; binaries of the 3ds Max versions it finds on the machine (InstallForMaxYear).
; Max 2016/2017 also get a startup loader for the MaxScripts, which they don't
; read from PackageContents.xml.
;
; Configured by CMake from packaging/Whiteout_Setup.iss.in — do not edit the
; generated copy under <build>/packaging/. See the root CMakeLists.txt for the
; substitution list (version, paths, per-version [Files] block).
; ============================================================================

#define MyAppName      "WhiteoutDex Toolkit"
#define MyAppVersion   "@WDX_VERSION@"
#define MyAppPublisher "Whiteout Contributors"
#define MyAppURL       "https://www.whiteout.de"

; --- GitHub Update Config ---
#define GitHubUser     "FernandoS27"
#define GitHubRepo     "WhiteoutDex"

; --- Legacy AppId (releases up to and including 0.0.1) ---
; This GUID was copied from NeoDex, so both toolkits registered under the same
; uninstall key and each installer silently uninstalled the other. We no longer
; install under it, but GetPreviousInnoUninstallString() still reads it so an
; older WhiteoutDex can be upgraded — guarded by a DisplayName check so a
; NeoDex-owned key is never touched.
#define LegacyAppId               "{{C508AF39-A032-496D-AC08-EE5B20E69FDB}"
#define LegacyAppIdLastVersion    "0.0.1"

[Setup]
AppId={{88D96963-9318-4DE5-BF7B-0B7E29F96509}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL=https://github.com/{#GitHubUser}/{#GitHubRepo}/releases
VersionInfoVersion={#MyAppVersion}

; Install location (GetDefaultDir): always
;   %ALLUSERSPROFILE%\Autodesk\ApplicationPlugins\WhiteoutDex
; Every Max version scans that root — it is where Autodesk's own bundles go —
; and it is the only choice that means the same thing under elevation. See
; GetDefaultDir() for why the old per-user branch had to go.
DefaultDirName={code:GetDefaultDir}
DirExistsWarning=no
DisableProgramGroupPage=yes
DisableDirPage=yes

; Output
OutputDir=@WDX_INSTALLER_OUTPUT_DIR@
OutputBaseFilename=WhiteoutDex_Setup_v{#MyAppVersion}

; Compression
Compression=lzma2/ultra64
SolidCompression=yes
LZMANumBlockThreads=4
; Every Max year's binaries in one solid stream is several hundred MB of input,
; and 4 block threads at a 64 MB dictionary need more memory than the 32-bit
; ISCC process has — the compile dies with "Out of memory". A separate process
; is 64-bit on x64 Windows and has no such ceiling.
LZMAUseSeparateProcess=yes

; Misc
; Admin required: the package goes under ProgramData, and the bundled VC++
; redistributable is a machine-wide install. Note that under elevation the
; user-area constants ({userappdata} and friends) refer to whoever answered
; the UAC prompt, not to whoever runs Max — nothing installed here may depend
; on them.
PrivilegesRequired=admin
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
LicenseFile=@WDX_REPO_ROOT@\LICENSE.md
WizardStyle=modern
WizardSizePercent=120
ShowLanguageDialog=no
LanguageDetectionMethod=uilanguage

; Allow update over existing installation
UsePreviousAppDir=yes
CloseApplications=no

[Languages]
; The ten languages the toolkit itself ships (see
; src/pre_startup_scripts/WhiteoutDexLocalization.ms) — the installer speaks the
; same set, picked from the Windows UI language by LanguageDetectionMethod above.
;
; Nine come from a stock Inno Setup 6 install. Simplified Chinese does not ship
; with Inno Setup, so it is bundled here: ChineseSimplified.isl is layered ON TOP
; of Default.isl (that is what the comma means — later files win), and it
; translates the messages this particular installer actually shows. Anything a
; streamlined installer never reaches — the components page, the Start Menu
; page, the download and archive errors — falls through to the English in
; Default.isl rather than being half-translated by us. Replacing it with the
; full community translation from https://jrsoftware.org/files/istrans/ is a
; drop-in swap: keep the file name and drop the ",compiler:Default.isl" prefix.
;
; Portuguese: the toolkit translates pt-BR only, so the wizard uses Inno's
; BrazilianPortuguese.isl. European Portuguese resolves here too, the same way
; detectMaxLanguage() maps a bare "pt" onto the Brazilian catalog.
Name: "english";   MessagesFile: "compiler:Default.isl"
Name: "german";    MessagesFile: "compiler:Languages\German.isl"
Name: "japanese";  MessagesFile: "compiler:Languages\Japanese.isl"
Name: "russian";   MessagesFile: "compiler:Languages\Russian.isl"
Name: "korean";    MessagesFile: "compiler:Languages\Korean.isl"
Name: "french";    MessagesFile: "compiler:Languages\French.isl"
Name: "spanish";   MessagesFile: "compiler:Languages\Spanish.isl"
Name: "italian";   MessagesFile: "compiler:Languages\Italian.isl"
Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
Name: "chinesesimplified"; MessagesFile: "compiler:Default.isl,@WDX_REPO_ROOT@\packaging\ChineseSimplified.isl"

; ============================================================================
; CUSTOM MESSAGES
;
; Everything the [Code] section below puts in a MsgBox. Pascal reads them with
; CustomMessage('Name'), which resolves against the language the wizard is
; running in — so these have to stay in step with [Languages] above: a name
; missing for the active language is a run-time error, not a compile one.
;
; %n is a line break. Inno's own wizard text is not here; that comes from the
; .isl files.
; ============================================================================
[CustomMessages]
english.NoAutodesk=The Autodesk AppData folder was not found.%nIs 3ds Max installed?%n%nInstall anyway?
german.NoAutodesk=Der Autodesk-AppData-Ordner wurde nicht gefunden.%nIst 3ds Max installiert?%n%nTrotzdem installieren?
japanese.NoAutodesk=Autodesk の AppData フォルダーが見つかりませんでした。%n3ds Max はインストールされていますか?%n%nこのままインストールしますか?
russian.NoAutodesk=Папка Autodesk AppData не найдена.%nУстановлен ли 3ds Max?%n%nВсё равно установить?
korean.NoAutodesk=Autodesk AppData 폴더를 찾을 수 없습니다.%n3ds Max가 설치되어 있습니까?%n%n그래도 설치할까요?
chinesesimplified.NoAutodesk=未找到 Autodesk AppData 文件夹。%n是否已安装 3ds Max？%n%n仍要继续安装吗？
french.NoAutodesk=Le dossier AppData d'Autodesk est introuvable.%n3ds Max est-il installé ?%n%nInstaller quand même ?
spanish.NoAutodesk=No se ha encontrado la carpeta AppData de Autodesk.%n¿Está instalado 3ds Max?%n%n¿Instalar de todos modos?
italian.NoAutodesk=Cartella AppData di Autodesk non trovata.%n3ds Max è installato?%n%nInstallare comunque?
brazilianportuguese.NoAutodesk=A pasta AppData da Autodesk não foi encontrada.%nO 3ds Max está instalado?%n%nInstalar mesmo assim?

