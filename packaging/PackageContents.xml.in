<?xml version="1.0" encoding="utf-8"?>
<!--
********************************************************************
WhiteoutDex Toolkit - PackageContents.xml
Warcraft III MDX/MDL Modeling Toolkit for 3ds Max

Generated by CMake from packaging/PackageContents.xml.in. Do not edit
the generated copy under <build>/packaging/.
********************************************************************
-->
<ApplicationPackage
    SchemaVersion="1.0"
    ProductType="Application"
    AutodeskProduct="3ds Max"
    Name="WhiteoutDex Manager"
    Description="Warcraft III MDX/MDL modeling toolkit"
    AppVersion="@WDX_VERSION@"
    Author="Fernando Sahmkow &amp; Benjamin Schiefer"
    ProductCode="@WDX_PRODUCT_CODE@"
    UpgradeCode="{4583FEEB-C403-46E3-9C96-4563A4A34E24}">

    <!-- Top-level RuntimeRequirements. SeriesMin/SeriesMax must bracket every
         per-version <Components> block below; if Max's version falls outside
         this range it ignores the entire package (no binary-compat fallback). -->
    <RuntimeRequirements
        OS="Win64"
        Platform="3ds Max"
        SeriesMin="@WDX_SERIES_MIN@"
        SeriesMax="@WDX_SERIES_MAX@" />

    <CompanyDetails
        Name="Sahmkow &amp; Schiefer"
        Url="www.benjaminschiefer.de"
        Email="kontakt@benjaminschiefer.de" />

    <!-- ================================================================
         NATIVE PLUGINS — one Components block per (Max version × plugin).
         CMake generates the contents from WDX_MAX_VERSIONS so the manifest
         always tracks the binaries the installer actually ships.
         ================================================================ -->

@WDX_NATIVE_PLUGINS_COMPONENTS@

    <!-- ================================================================
         MaxScript: pre-start-up scripts. Scripted plugins (FaceFX, Popcorn,
         Wc3*…) are bundled in this block too — there is no separate
         Description="scripted plugins" category in the package spec, so they
         load as pre-start-up scripts (Max picks up the scripted-plugin
         registrations from the .ms files themselves).
         ================================================================ -->

    <Components Description="pre-start-up scripts parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max"
                             SeriesMin="@WDX_SERIES_MIN@" SeriesMax="@WDX_SERIES_MAX@" />
@WDX_PRE_STARTUP_ENTRIES@
@WDX_SCRIPTED_PLUGINS_ENTRIES@
    </Components>
@WDX_MENU_CALLBACK_COMPONENTS@

    <!-- ================================================================
         MaxScript: post-start-up scripts
         ================================================================ -->

    <Components Description="post-start-up scripts parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max"
                             SeriesMin="@WDX_SERIES_MIN@" SeriesMax="@WDX_SERIES_MAX@" />
@WDX_POST_STARTUP_ENTRIES@
    </Components>
@WDX_MENU_INSTALLER_COMPONENTS@

    <!-- ================================================================
         MaxScript: macroscripts (all versions)
         ================================================================ -->

    <Components Description="macroscripts parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max"
                             SeriesMin="@WDX_SERIES_MIN@" SeriesMax="@WDX_SERIES_MAX@" />
@WDX_MACROSCRIPTS_ENTRIES@
    </Components>

</ApplicationPackage>
