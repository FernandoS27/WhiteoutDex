/*
	WhiteoutDexLocalization.ms
	=====================
	Central localization file for the WhiteoutDex Toolkit.
	
	Supported languages: English (en), Chinese (zh), German (de),
	Russian (ru), Japanese (ja), Korean (ko), French (fr), Spanish (es),
	Italian (it), Brazilian Portuguese (pt-br)
	
	HOW IT WORKS:
	  - Each language has its own data section with #("key", "translated text")
	  - The code uses ::WdxL.t "key" to get the text in the active language
	  - If the translated text is "" (empty), it falls back to English
	  - On startup, the system auto-detects the language from 3ds Max locale
	  - The user can manually switch via Settings menu or ::WdxL.setLanguage "de"
	  - The choice is saved in WhiteoutDex_Settings.ini
	
	HOW TO TRANSLATE:
	  Find your language section and fill in the translations.
	  Leave "" for entries you haven't translated yet - they show English.
	
	HOW TO ADD A NEW LANGUAGE:
	  1. Add a new data section (copy enData, rename to xxData)
	  2. Add "xx" to supportedLanguages array
	  3. Add xxDict declaration and loading in loadTranslations
	  4. Add "xx" case to t() function and detectMaxLanguage()
	  5. Add display name to Settings.mcr dropdown
	  Use the same code WhiteoutFlakes uses for the renderer catalogs, so one
	  setting drives both — that is why Brazilian Portuguese is "pt-br" and not
	  "pt". A hyphen is legal in the code but not in a MaxScript identifier, so
	  the matching section and dict drop it: "pt-br" -> ptbrData / ptbrDict.
	  detectMaxLanguage only sees a two-letter code from .NET, so map it there
	  ("pt" -> "pt-br").
	
	HOW TO ADD A NEW STRING:
	  1. Add #("mymodule_my_label", "My Label") to enData
	  2. Add #("mymodule_my_label", "翻译") to zhData (and other languages)
	  3. Use in code: ::WdxL.t "mymodule_my_label"

	WHO ELSE READS THIS CATALOG:
	  - MaxScript UI: ::WdxL.t "key" for one string, ::WdxL.tList "key" for a
	    pipe-joined choice list ("New Scene|Merge") bound to a dropdownlist's
	    .items or a radiobuttons' .labels.
	  - The native Win32 dialogs — importer, exporter, Wc3Particles1/2,
	    Wc3Ribbon — relabel themselves from these same keys at WM_INITDIALOG.
	    They reach the catalog through src/native_sources/common/wdx_localization.h,
	    which asks MaxScript for a batch of translations in one call. So a key
	    used by a native dialog lives here, not in a C++ string table.
	  - NOT the renderer window or the asset picker. Those are WhiteoutFlakes'
	    ImGui chrome hosted inside Max, and read the submodule's own
	    lang/<code>.ini catalogs (eleven languages) instead — see
	    src/native_sources/WhiteoutDexRenderer/wdx_ui_language.h. WhiteoutDex's
	    additions to that set live in resources/lang/wdx_<code>.ini.

	WHERE THE PREFERENCE LIVES:
	  <plugcfg>\WhiteoutDex_Settings.ini -> [Localization] Language.
	  NOT the copy beside PackageContents.xml: a system-wide install leaves
	  that one read-only for ordinary users, so writes there are dropped and
	  the choice reappears as English on the next start. plugcfg is also what
	  the renderer reads (wdx_ui_language.h), so one write covers both.

	KNOWN LIMITATION — menu bar needs a restart:
	  The menu is built once, from #cuiRegisterMenus (Max 2025+) or at
	  postSystemStartup (2016-2024). Neither the CUI menu manager nor menuMan
	  exposes a rebuild, so a language change reaches the menu on the next
	  start of 3ds Max. Dialogs and the sidebar re-read the catalog every time
	  they open, so those change straight away.

	KNOWN LIMITATION — macroScript `toolTip:`:
	  A macroScript's toolTip and buttonText are fixed when the action is
	  registered and have no runtime setter, so they stay English wherever Max
	  itself shows them: Customize User Interface, and a toolbar button a user
	  made. Every surface WhiteoutDex draws itself does translate — the menu
	  overrides the label per item (see WhiteoutDexMenuCallback.ms) and the
	  sidebar sets its own button tooltips from this catalog.

	KNOWN LIMITATION — `group` captions:
	  A MaxScript `group "Caption" ( ... )` block has no control name, so its
	  caption cannot be reassigned at runtime and stays English. `groupBox`
	  controls DO have a name and are translated. Eleven captions are affected
	  (Wc3Light, Wc3Material, Wc3AttachPoint, Wc3RefEvent, SkinChanger,
	  Keyframe_Optimizer); converting them to groupBox would mean re-laying out
	  the rollouts by hand, since `group` also indents what it contains.

	Load Order: After WhiteoutDexGlobals.ms, before all UI scripts.
*/

-- ============================================================================
-- MAX 2016 COMPATIBILITY LAYER
-- Dictionary #string was introduced in Max 2017.1. For Max 2016 (base),
-- we provide a polyfill struct with the same interface.
-- ============================================================================

global _wdxHasNativeDict = true
try (Dictionary #string) catch (_wdxHasNativeDict = false)

struct _WdxDictPolyfill (public _k = #(), public _v = #(), public count = 0)

fn _wdxNewDict =
(
	if ::_wdxHasNativeDict then
		(execute "Dictionary #string")
	else
		(_WdxDictPolyfill())
)

fn _wdxDictSet dict key val =
(
	if ::_wdxHasNativeDict then
	(
		dict[key] = val
	)
	else
	(
		local idx = findItem dict._k key
		if idx == 0 then
		(
			append dict._k key
			append dict._v val
			dict.count = dict._k.count
		)
		else
			dict._v[idx] = val
	)
	val
)

fn _wdxDictGet dict key =
(
	if ::_wdxHasNativeDict then
		dict[key]
	else
	(
		local idx = findItem dict._k key
		if idx == 0 then undefined else dict._v[idx]
	)
)

fn _wdxDictHas dict key =
(
	if ::_wdxHasNativeDict then
		hasDictValue dict key
	else
		(findItem dict._k key) != 0
)

fn _wdxDictCount dict =
(
	if ::_wdxHasNativeDict then
		dict.count
	else
		dict._k.count
)

-- ============================================================================

struct WhiteoutDexLocalizationStruct
(
	public currentLanguage = "en",
	public supportedLanguages = #("en", "zh", "de", "ru", "ja", "ko",
		"fr", "es", "it", "pt-br"),
	
	-- Internal storage (uses polyfill on Max 2016, native Dictionary on 2017.1+)
	private enDict = _wdxNewDict(),
	private zhDict = _wdxNewDict(),
	private deDict = _wdxNewDict(),
	private ruDict = _wdxNewDict(),
	private jaDict = _wdxNewDict(),
	private koDict = _wdxNewDict(),
	private frDict = _wdxNewDict(),
	private esDict = _wdxNewDict(),
	private itDict = _wdxNewDict(),
	private ptbrDict = _wdxNewDict(),
	private iniPath = "",
	
	-- ====================================================================
	-- PUBLIC API
	-- ====================================================================
	
	-- Get translated string for current language. Falls back to English.
	public fn t key =
	(
		local dict = undefined
		case this.currentLanguage of
		(
			"zh": dict = this.zhDict
			"de": dict = this.deDict
			"ru": dict = this.ruDict
			"ja": dict = this.jaDict
			"ko": dict = this.koDict
			"fr": dict = this.frDict
			"es": dict = this.esDict
			"it": dict = this.itDict
			"pt-br": dict = this.ptbrDict
		)
		if dict != undefined then
		(
			if _wdxDictHas dict key then
			(
				local val = _wdxDictGet dict key
				if val != "" then return val
			)
		)
		-- Fallback to English
		if _wdxDictHas this.enDict key then
			return (_wdxDictGet this.enDict key)
		-- Last resort: return key name (helps spot missing entries)
		key
	),
	
	-- Translated pipe-joined list -> array of strings.
	-- Catalog entries whose key ends in "_labels" / "_items" hold one string
	-- per choice separated by "|", so a dropdownlist / radiobuttons control can
	-- be relabelled in one assignment:
	--     ddFilterMode.items = ::WdxL.tList "mat_filter_mode_items"
	-- filterString drops empty tokens, so a translator who leaves a trailing
	-- "|" cannot shorten the list and desynchronise it from the value indices.
	public fn tList key =
	(
		local s = this.t key
		local parts = filterString s "|"
		if parts.count == 0 then #(s) else parts
	),

	-- Switch language: any code in supportedLanguages.
	public fn setLanguage lang =
	(
		lang = toLower lang
		if findItem this.supportedLanguages lang == 0 then
		(
			format "WhiteoutDex L10n: '%' not supported\n" lang
			return false
		)
		this.currentLanguage = lang
		if this.iniPath != "" then
		(
			-- setINISetting reports success even when the file cannot be
			-- written, so the value is read back. Silence here is what made
			-- the choice look like it saved and then reappear as English on
			-- the next start.
			local stored = ""
			try
			(
				setINISetting this.iniPath "Localization" "Language" lang
				stored = getINISetting this.iniPath "Localization" "Language"
			)
			catch ()
			if stored != lang then
				format "WhiteoutDex L10n: could not save the language to % - it will reset on restart\n" this.iniPath
		)
		format "WhiteoutDex L10n: set to '%'\n" lang
		true
	),
	
	public fn getLanguage = this.currentLanguage,
	public fn getAvailableLanguages = this.supportedLanguages,
	
	-- ====================================================================
	-- AUTO-DETECTION
	-- ====================================================================
	
	public fn detectMaxLanguage =
	(
		local detected = "en"
		try (
			-- Check system locale via .NET
			local ci = (dotNetClass "System.Globalization.CultureInfo").CurrentUICulture
			local lang2 = toLower ci.TwoLetterISOLanguageName
			if lang2 == "zh" then return "zh"
			if lang2 == "de" then return "de"
			if lang2 == "ru" then return "ru"
			if lang2 == "ja" then return "ja"
			if lang2 == "ko" then return "ko"
			if lang2 == "fr" then return "fr"
			if lang2 == "es" then return "es"
			if lang2 == "it" then return "it"
			-- Only the Brazilian catalog exists, and it is the reading most
			-- Portuguese speakers here have; European Portuguese lands on it too.
			if lang2 == "pt" then return "pt-br"
			-- Check userscripts path for Chinese subfolder
			local p = toUpper (getDir #userscripts)
			if (findString p "\\CHS") != undefined or (findString p "\\ZH-CN") != undefined then
				return "zh"
			-- Check maxroot path
			p = toUpper (getDir #maxroot)
			if (findString p "\\CHS") != undefined or (findString p "\\ZH-CN") != undefined then
				return "zh"
		) catch ()
		detected
	),
	
	-- ====================================================================
	-- TRANSLATION DATA
	-- ====================================================================
	
