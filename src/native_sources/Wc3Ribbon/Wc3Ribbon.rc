// String Table
//

STRINGTABLE
BEGIN
    IDS_GENERAL             "General"
    IDS_CLASSNAME           "Wc3Ribbon"
    IDS_PARAMCHANGE         "Parameter Change"
    IDS_LENGTH              "Length"
    IDS_WIDTH               "Width"
    IDS_LIBDESCRIPTION      "Warcraft III Ribbon Emitter Library"
    IDS_PARAMS              "Parameters"
    IDS_HEIGHTABOVE         "Height Above"
    IDS_HEIGHTBELOW         "Height Below"
    IDS_EDGESPERSEC         "Edges Per Second"
    IDS_EDGELIFETIME        "Edge Lifetime"
    IDS_TEXROWS             "Texture Rows"
    IDS_TEXCOLS             "Texture Columns"
    IDS_TEXSLOT             "Texture Slot"
    IDS_MATERIAL            "Material"
    IDS_COLOR               "Color"
    IDS_ALPHA               "Alpha"
    IDS_GRAVITY             "Gravity"
    IDS_CATEGORY            "Particle Systems"
    IDS_ROLLOUT_PROPERTIES  "Ribbon Properties"
    IDS_ROLLOUT_MATERIAL    "Ribbon Material Parameters"
END
