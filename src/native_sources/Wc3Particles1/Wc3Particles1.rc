/**
 * @file Wc3Particles1.rc
 * @brief Dialog and string-table resources for the Wc3Particles1 3ds Max plugin.
 *
 * Contains four rollout panels and the string table used by the PB2 descriptor
 * and DLL entry points.
 */

#include "resource.h"
#include <windows.h>

#ifdef _WIN32
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)
#endif

/* Particle Configuration rollout (Import/Export) */
IDD_P1_ROLLOUT_CONFIG DIALOG 0, 0, 110, 44
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "Import", IDC_P1_BUTTON_IMPORT, 7, 4, 45, 14
    PUSHBUTTON      "Export", IDC_P1_BUTTON_EXPORT, 57, 4, 45, 14
    CONTROL         "Load Dynamic Values", IDC_P1_CHECK_LOAD_DYNAMIC, "Button",
                    BS_AUTOCHECKBOX | BS_LEFTTEXT | WS_TABSTOP, 7, 24, 90, 10
END

/* Emitter Options rollout */
IDD_P1_ROLLOUT_EMITTER DIALOG 0, 0, 110, 148
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Count:", WDXP1_LBL_COUNT, 7, 6, 50, 8
    CONTROL         "", IDC_P1_EDIT_COUNT, "CustEdit", WS_TABSTOP, 60, 5, 34, 10
    CONTROL         "", IDC_P1_SPIN_COUNT, "SpinnerControl", 0, 95, 5, 7, 10

    LTEXT           "Speed ...............", WDXP1_LBL_SPEED, 7, 22, 52, 8
    CONTROL         "", IDC_P1_EDIT_SPEED, "CustEdit", WS_TABSTOP, 60, 21, 34, 10
    CONTROL         "", IDC_P1_SPIN_SPEED, "SpinnerControl", 0, 95, 21, 7, 10
    LTEXT           "Control:", WDXP1_LBL_CONTROL, 7, 35, 28, 8
    COMBOBOX        IDC_P1_CTRL_SPEED, 60, 34, 42, 50, CBS_DROPDOWNLIST | WS_TABSTOP

    LTEXT           "Latitude ............", WDXP1_LBL_LATITUDE, 7, 50, 52, 8
    CONTROL         "", IDC_P1_EDIT_LATITUDE, "CustEdit", WS_TABSTOP, 60, 49, 34, 10
    CONTROL         "", IDC_P1_SPIN_LATITUDE, "SpinnerControl", 0, 95, 49, 7, 10
    LTEXT           "Control:", WDXP1_LBL_CONTROL_2, 7, 63, 28, 8
    COMBOBOX        IDC_P1_CTRL_LATITUDE, 60, 62, 42, 50, CBS_DROPDOWNLIST | WS_TABSTOP

    LTEXT           "Longitude .........", WDXP1_LBL_LONGITUDE, 7, 78, 52, 8
    CONTROL         "", IDC_P1_EDIT_LONGITUDE, "CustEdit", WS_TABSTOP, 60, 77, 34, 10
    CONTROL         "", IDC_P1_SPIN_LONGITUDE, "SpinnerControl", 0, 95, 77, 7, 10
    LTEXT           "Control:", WDXP1_LBL_CONTROL_3, 7, 91, 28, 8
    COMBOBOX        IDC_P1_CTRL_LONGITUDE, 60, 90, 42, 50, CBS_DROPDOWNLIST | WS_TABSTOP

    LTEXT           "Gravity ............", WDXP1_LBL_GRAVITY, 7, 106, 52, 8
    CONTROL         "", IDC_P1_EDIT_ACCEL, "CustEdit", WS_TABSTOP, 60, 105, 34, 10
    CONTROL         "", IDC_P1_SPIN_ACCEL, "SpinnerControl", 0, 95, 105, 7, 10
    LTEXT           "Control:", WDXP1_LBL_CONTROL_4, 7, 119, 28, 8
    COMBOBOX        IDC_P1_CTRL_ACCEL, 60, 118, 42, 50, CBS_DROPDOWNLIST | WS_TABSTOP
END

/* Timing Options rollout */
IDD_P1_ROLLOUT_TIMING DIALOG 0, 0, 110, 50
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Lifespan:", WDXP1_LBL_LIFESPAN, 7, 6, 48, 8
    CONTROL         "", IDC_P1_EDIT_LIFE, "CustEdit", WS_TABSTOP, 60, 5, 34, 10
    CONTROL         "", IDC_P1_SPIN_LIFE, "SpinnerControl", 0, 95, 5, 7, 10

    LTEXT           "Emission Rate:", WDXP1_LBL_EMISSION_RATE, 7, 21, 52, 8
    CONTROL         "", IDC_P1_EDIT_EMISSION, "CustEdit", WS_TABSTOP, 60, 20, 34, 10
    CONTROL         "", IDC_P1_SPIN_EMISSION, "SpinnerControl", 0, 95, 20, 7, 10
    LTEXT           "Control:", WDXP1_LBL_CONTROL_5, 7, 34, 28, 8
    COMBOBOX        IDC_P1_CTRL_EMISSION, 60, 33, 42, 50, CBS_DROPDOWNLIST | WS_TABSTOP
END

/* Model Options rollout */
IDD_P1_ROLLOUT_MODEL DIALOG 0, 0, 110, 113
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "- Model Path Prefix -", WDXP1_LBL_MODEL_PATH_PREFIX, 18, 5, 74, 8
    CONTROL         "", IDC_P1_EDIT_PATH_PREFIX, "CustEdit",
                    WS_TABSTOP, 7, 16, 95, 11

    LTEXT           "- Particle Model File -", WDXP1_LBL_PARTICLE_MODEL_FILE, 17, 33, 76, 8
    CONTROL         "", IDC_P1_CUSTOMEDIT_PATH, "CustEdit",
                    WS_TABSTOP, 7, 44, 95, 11

    PUSHBUTTON      "Browse Game Archives", IDC_P1_BUTTON_BROWSE_CASC, 7, 60, 95, 14
    PUSHBUTTON      "Import Model File", IDC_P1_BUTTON_BROWSE, 7, 77, 95, 14

    LTEXT           "Particle Scale:", WDXP1_LBL_PARTICLE_SCALE, 7, 99, 50, 8
    CONTROL         "", IDC_P1_EDIT_SCALE, "CustEdit", WS_TABSTOP, 60, 98, 34, 10
    CONTROL         "", IDC_P1_SPIN_SCALE, "SpinnerControl", 0, 95, 98, 7, 10
END

/* String table */
STRINGTABLE
BEGIN
    IDS_P1_CLASS_NAME           "Wc3Particles1"
    IDS_P1_OBJECT_NAME          "Wc3Particles1"
    IDS_P1_CATEGORY             "Particle Systems"
    IDS_P1_LIB_DESCRIPTION      "Warcraft III Model Particle objects"
    IDS_P1_PARAM_COUNT          "Viewport Particles"
    IDS_P1_PARAM_SPEED          "Speed"
    IDS_P1_PARAM_EMISSION       "Parts/Sec"
    IDS_P1_PARAM_LIFE           "Life Time"
    IDS_P1_PARAM_ACCEL          "Gravity"
    IDS_P1_PARAM_LATITUDE       "Latitude"
    IDS_P1_PARAM_LONGITUDE      "Longitude"
    IDS_P1_PARAM_SCALE          "Scale"
    IDS_P1_ROLLOUT_CONFIG       "Particle Configuration"
    IDS_P1_ROLLOUT_EMITTER      "Emitter Options"
    IDS_P1_ROLLOUT_TIMING       "Timing Options"
    IDS_P1_ROLLOUT_MODEL        "Model Options"
END
