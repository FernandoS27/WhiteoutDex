// MDLXImporter — Import options dialog resource
#include "resource.h"
#include <windows.h>

#ifdef _WIN32
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)
#endif

// ============================================================================
// Import Options Dialog (redesign, September 2026)
// Header with the file, Fast Settings drop-down, Mode cards, three tabs
// (Objects / Animations / Model) and a footer with the texture archive status.
//
// All positions below are placeholders: layoutImportDialog() in
// import_dialog.cpp sets the real rectangles in pixels (96-DPI values scaled
// by the dialog's DPI). This template defines the controls, their styles and
// the tab order (= order in this block).
// Owner-drawn: mode cards, tabs, Import.
// ============================================================================
IDD_IMPORT_OPTIONS DIALOGEX 0, 0, 281, 277
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "WhiteoutDex Importer"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // ── Fast Settings / Mode ──
    LTEXT           "Fast Settings", IDC_LBL_FAST_SETTINGS, 0, 0, 10, 8
    COMBOBOX        IDC_CMB_FAST_SETTINGS, 0, 0, 10, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "Mode", IDC_LBL_MODE, 0, 0, 10, 8
    CONTROL         "New Scene", IDC_BTN_MODE_NEW_SCENE, "Button",
                    BS_OWNERDRAW | BS_NOTIFY | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Merge", IDC_BTN_MODE_MERGE, "Button",
                    BS_OWNERDRAW | BS_NOTIFY, 0, 0, 10, 10

    // ── Tabs ──
    CONTROL         "Objects", IDC_BTN_TAB_OBJECTS, "Button",
                    BS_OWNERDRAW | BS_NOTIFY | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Animations", IDC_BTN_TAB_ANIMATIONS, "Button",
                    BS_OWNERDRAW | BS_NOTIFY, 0, 0, 10, 10
    CONTROL         "Model", IDC_BTN_TAB_MODEL, "Button",
                    BS_OWNERDRAW | BS_NOTIFY, 0, 0, 10, 10

    // ── Objects tab ──
    CONTROL         "Import Objects", IDC_CHK_IMPORT_OBJECTS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 0, 0, 10, 10
    CONTROL         "Bones", IDC_CHK_BONES, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_BONES, 0, 0, 10, 8, SS_NOPREFIX
    CONTROL         "Helpers", IDC_CHK_HELPERS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_HELPERS, 0, 0, 10, 8, SS_NOPREFIX
    CONTROL         "Lights", IDC_CHK_LIGHTS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_LIGHTS, 0, 0, 10, 8, SS_NOPREFIX
    CONTROL         "Attachments", IDC_CHK_ATTACHMENTS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_ATTACHMENTS, 0, 0, 10, 8, SS_NOPREFIX
    CONTROL         "Event Objects", IDC_CHK_EVENT_OBJECTS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_EVENT_OBJECTS, 0, 0, 10, 8, SS_NOPREFIX
    CONTROL         "Particle Emitters 1", IDC_CHK_PE1, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_PE1, 0, 0, 10, 8, SS_NOPREFIX
    CONTROL         "Particle Emitters 2", IDC_CHK_PE2, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_PE2, 0, 0, 10, 8, SS_NOPREFIX
    CONTROL         "Ribbon Emitters", IDC_CHK_RIBBON_EMITTERS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_RIBBON_EMITTERS, 0, 0, 10, 8, SS_NOPREFIX
    CONTROL         "Collision Shapes", IDC_CHK_COLLISION_SHAPES, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_COLLISION_SHAPES, 0, 0, 10, 8, SS_NOPREFIX
    CONTROL         "Cameras", IDC_CHK_CAMERAS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_CAMERAS, 0, 0, 10, 8, SS_NOPREFIX
    CONTROL         "Corn Emitters", IDC_CHK_CORN_EMITTERS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_CORN_EMITTERS, 0, 0, 10, 8, SS_NOPREFIX
    CONTROL         "FaceFX", IDC_CHK_FACEFX, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_FACEFX, 0, 0, 10, 8, SS_NOPREFIX
    LTEXT           "This file has no objects.", IDC_LBL_NO_OBJECTS, 0, 0, 10, 8, SS_NOPREFIX

    // ── Animations tab ──
    CONTROL         "Import Animations", IDC_CHK_IMPORT_ANIMATIONS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_IMPORT_ANIMATIONS, 0, 0, 10, 8, SS_NOPREFIX
    CONTROL         "Translation", IDC_CHK_TRANSLATION, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Rotations", IDC_CHK_ROTATIONS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Scale", IDC_CHK_SCALE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Visibility", IDC_CHK_VISIBILITY, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Parameter", IDC_CHK_PARAMETER, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Unwrap Animations", IDC_CHK_UNWRAP_ANIMS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Texture Animations", IDC_CHK_TEXTURE_ANIMS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Color", IDC_CHK_COLOR, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    LTEXT           "This file has no animations.", IDC_LBL_NO_ANIMATIONS, 0, 0, 10, 8, SS_NOPREFIX

    // ── Model tab ──
    CONTROL         "Skinned", IDC_CHK_SKINNED, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 0, 0, 10, 10
    CONTROL         "Import Materials", IDC_CHK_IMPORT_MATERIALS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_IMPORT_MATERIALS, 0, 0, 10, 8, SS_NOPREFIX
    CONTROL         "Import Textures", IDC_CHK_IMPORT_TEXTURES, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    RTEXT           "0", IDC_CNT_IMPORT_TEXTURES, 0, 0, 10, 8, SS_NOPREFIX
    LTEXT           "Options", IDC_LBL_OPTIONS, 0, 0, 10, 8
    CONTROL         "Import Helpers as Point Helpers", IDC_CHK_POINT_HELPERS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 0, 0, 10, 10
    CONTROL         "Optimize Geometry", IDC_CHK_OPT_GEOMETRY, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Optimize Bones and Helpers", IDC_CHK_OPT_BONES, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10

    // ── Footer (the texture archive status is painted by the dialog) ──
    CONTROL         "Import", IDOK, "Button",
                    BS_OWNERDRAW | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    PUSHBUTTON      "Cancel", IDCANCEL, 0, 0, 10, 10, WS_TABSTOP
END

// ============================================================================
// Window icon - the shared 16-64 px WhiteoutDex icon, put on the dialog from
// WM_INITDIALOG (see common/wdx_window_icon.h). rc.exe anchors a relative name
// at the first /I entry, which is this plug-in's own src/ directory.
// ============================================================================
IDI_WHITEOUTDEX_ICON ICON "../../../../whiteoutdex_icons/whiteoutdex.ico"
