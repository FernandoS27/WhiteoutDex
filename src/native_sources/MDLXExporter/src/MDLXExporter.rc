// MDLXExporter — Export options dialog resource
#include "resource.h"
#include <windows.h>

#ifdef _WIN32
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)
#endif

// ============================================================================
// Export Options Dialog (redesign, September 2026)
// File path is taken from Max's File→Export save dialog (mdxExport() lets the
// user pick it after this dialog instead).
// Two tabs: Geometry + Textures. The Textures tab swaps its inner content
// depending on the format (BLP rows for v800, DDS row for v1800).
//
// All positions below are placeholders: layoutExportDialog() in
// export_dialog.cpp sets the real rectangles in pixels (96-DPI values scaled
// by the dialog's DPI). This template defines the controls, their styles and
// the tab order (= order in this block).
// Owner-drawn: format cards, tabs, banner buttons, footer check buttons, Export.
// ============================================================================
IDD_EXPORT_OPTIONS DIALOGEX 0, 0, 241, 303
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Export Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // ── Model name / format ──
    LTEXT           "Model name", IDC_LBL_MODEL_NAME, 0, 0, 10, 8
    EDITTEXT        IDC_EDT_MODEL_NAME, 0, 0, 10, 12, ES_AUTOHSCROLL
    LTEXT           "Format", IDC_LBL_FORMAT, 0, 0, 10, 8
    CONTROL         "Classic", IDC_BTN_FORMAT_CLASSIC, "Button",
                    BS_OWNERDRAW | BS_NOTIFY | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Reforged", IDC_BTN_FORMAT_REFORGED, "Button",
                    BS_OWNERDRAW | BS_NOTIFY, 0, 0, 10, 10

    // ── Tabs ──
    CONTROL         "Geometry", IDC_BTN_TAB_GEOMETRY, "Button",
                    BS_OWNERDRAW | BS_NOTIFY | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Textures", IDC_BTN_TAB_TEXTURES, "Button",
                    BS_OWNERDRAW | BS_NOTIFY, 0, 0, 10, 10

    // ── Geometry tab ──
    CONTROL         "Merge similar meshes", IDC_CHK_MERGE_SIMILAR, "Button",
                    BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Fix shared normals", IDC_CHK_FIX_SHARED_NORMALS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Keep unused bones and helpers", IDC_CHK_KEEP_UNUSED_BH, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Quantize skin weights", IDC_CHK_QUANTIZE_SKIN, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    LTEXT           "Extents precision", IDC_LBL_EXTENTS_PREC, 0, 0, 10, 8
    EDITTEXT        IDC_EDT_EXTENTS_PREC, 0, 0, 10, 12,
                    ES_AUTOHSCROLL | ES_RIGHT | ES_NUMBER | WS_GROUP
    CONTROL         "", IDC_SPIN_EXTENTS_PREC, "msctls_updown32",
                    UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_SETBUDDYINT, 0, 0, 10, 12

    // ── Textures tab ──
    CONTROL         "Convert textures on export", IDC_CHK_TEX_CONVERT, "Button",
                    BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    LTEXT           "Compression", IDC_LBL_BLP_COMPRESSION, 0, 0, 10, 8
    COMBOBOX        IDC_CMB_BLP_COMPRESSION, 0, 0, 10, 60,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "JPEG quality", IDC_LBL_BLP_JPEG_QUALITY, 0, 0, 10, 8
    EDITTEXT        IDC_EDT_BLP_JPEG_QUALITY, 0, 0, 10, 12,
                    ES_AUTOHSCROLL | ES_RIGHT | ES_NUMBER
    CONTROL         "", IDC_SPIN_BLP_JPEG_QUALITY, "msctls_updown32",
                    UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_SETBUDDYINT, 0, 0, 10, 12
    CONTROL         "Dithering (reduces color banding)", IDC_CHK_BLP_DITHERING, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    LTEXT           "DDS format", IDC_LBL_DDS_FORMAT, 0, 0, 10, 8
    COMBOBOX        IDC_CMB_DDS_FORMAT, 0, 0, 10, 60,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Regenerate mipmaps", IDC_CHK_TEX_MIPMAPS, "Button",
                    BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Overwrite existing files", IDC_CHK_TEX_OVERWRITE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10

    // ── Scene check banner buttons (the banner is painted by the dialog) ──
    CONTROL         "Fix all", IDC_BTN_SCENE_FIX_ALL, "Button",
                    BS_OWNERDRAW | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Details...", IDC_BTN_SCENE_DETAILS, "Button",
                    BS_OWNERDRAW | WS_TABSTOP, 0, 0, 10, 10

    // ── Footer ──
    CONTROL         "Auto-increment name", IDC_CHK_AUTO_INCREMENT, "Button",
                    BS_OWNERDRAW | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Open folder afterwards", IDC_CHK_OPEN_FOLDER, "Button",
                    BS_OWNERDRAW | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Export", IDOK, "Button",
                    BS_OWNERDRAW | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    PUSHBUTTON      "Cancel", IDCANCEL, 0, 0, 10, 10, WS_TABSTOP
END


// ============================================================================
// Problem Details Dialog (Scene Monitor)
// Listview with all detected problems. Multi-select rows + "Fix Selected"
// applies per-category fixes. Double-click selects the offending node.
// ============================================================================
IDD_PROBLEM_DETAILS DIALOGEX 0, 0, 280, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Scene Problems"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Problems (double-click a row to select the node):",
                    IDC_LBL_PROBLEM_PROMPT, 7, 5, 266, 8

    CONTROL         "", IDC_LV_PROBLEMS, "SysListView32",
                    LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
                    7, 16, 266, 145

    LTEXT           "", IDC_LBL_PROBLEM_STATUS, 7, 165, 266, 8

    PUSHBUTTON      "Re-scan",       IDC_BTN_RESCAN,         7, 178, 50, 14
    PUSHBUTTON      "Fix Selected",  IDC_BTN_FIX_SELECTED,  62, 178, 60, 14
    PUSHBUTTON      "Fix All",       IDC_BTN_FIX_ALL,      127, 178, 50, 14
    DEFPUSHBUTTON   "Close",         IDOK,                 223, 178, 50, 14
END

// ============================================================================
// Window icon - the shared 16-64 px WhiteoutDex icon, put on the dialog from
// WM_INITDIALOG (see common/wdx_window_icon.h). rc.exe anchors a relative name
// at the first /I entry, which is this plug-in's own src/ directory.
// ============================================================================
IDI_WHITEOUTDEX_ICON ICON "../../../../whiteoutdex_icons/whiteoutdex.ico"
